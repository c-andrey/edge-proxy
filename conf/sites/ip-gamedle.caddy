# Acesso PÚBLICO POR IP enquanto o Gamedle não tem domínio: http://187.77.254.161/gamedle
# Só HTTP (certificado para IP daria aviso no navegador). noindex: o Google não deve
# indexar o site pelo IP — quando houver domínio, o endereço oficial é o gamedle.caddy.
# O app roda com BASE_PATH=/gamedle (workflow do repo gamedle), então recebe o caminho completo.
http://187.77.254.161 {
	header X-Robots-Tag "noindex, nofollow"

	@gamedle path /gamedle /gamedle/*
	handle @gamedle {
		encode zstd gzip
		reverse_proxy gamedle:3100 {
			transport http {
				dial_timeout 3s
			}
		}
	}

	handle {
		respond "Not found" 404
	}
}
