# Gamedle — endereço oficial https://gamedle.com.br (o app roda na raiz: BASE_PATH vazio).
# Ligado em 2026-10-21 (DNS A → 187.77.254.161 de gamedle.com.br, gamedle.dev e www). Substitui o
# antigo ip-gamedle.caddy: o acesso por IP virou o redirecionamento do fim deste arquivo.
# O app entra na rede "edge" pelo compose.proxy.yaml do repo gamedle (alias "gamedle").

# PROVISÓRIO (2026-10-21): o gamedle.com.br está "aguardando ativação" no registro.br, então o site sai
# pelo gamedle.dev. Quando o .com.br resolver, reverter este commit: .dev volta a redirecionar (301).
# Os blocos do .com.br já ficam aqui: o Caddy emite o certificado sozinho quando o DNS existir.
www.gamedle.dev {
	redir https://gamedle.dev{uri} permanent
}

www.gamedle.com.br {
	redir https://gamedle.com.br{uri} permanent
}

gamedle.com.br, gamedle.dev {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy gamedle:3100 {
		transport http {
			dial_timeout 3s
		}
		# deploy recria o contêiner: segura o pedido por até 10 s em vez de devolver 502
		lb_try_duration 10s
	}
}

# Endereço antigo por IP (http://187.77.254.161/gamedle/...) → domínio, sem o prefixo /gamedle.
http://187.77.254.161 {
	header X-Robots-Tag "noindex, nofollow"
	@gamedle path /gamedle /gamedle/*
	handle @gamedle {
		# route mantém a ordem escrita (sem ele o Caddy roda redir antes de uri e o /gamedle ficaria na URL)
		route {
			uri strip_prefix /gamedle
			redir https://gamedle.dev{uri} temporary
		}
	}
	handle {
		respond "Not found" 404
	}
}
