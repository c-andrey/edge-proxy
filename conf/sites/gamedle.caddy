# Gamedle — https://gamedle.com.br (pt) e https://gamedle.dev (en); o app roda na raiz (BASE_PATH vazio).
# Ligado em 2026-10-21 (DNS A → 187.77.254.161 de gamedle.com.br, gamedle.dev e www). Substituiu o
# antigo ip-gamedle.caddy: o acesso por IP virou o redirecionamento do fim deste arquivo.
# O app entra na rede "edge" pelo compose.proxy.yaml do repo gamedle (alias "gamedle").

# Um domínio por idioma: gamedle.com.br = português, gamedle.dev = inglês (o app decide pelo Host e
# liga os dois com hreflang). www → o próprio domínio (301). O .dev só existe com HTTPS (HSTS preload do TLD).
www.gamedle.com.br {
	redir https://gamedle.com.br{uri} permanent
}

www.gamedle.dev {
	redir https://gamedle.dev{uri} permanent
}

gamedle.com.br, gamedle.dev {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy gamedle:3100 {
		transport http {
			dial_timeout 3s
		}
		# deploy recria o contêiner: segura o pedido por até 10 s em vez de devolver 502
		lb_try_duration 10s
	}
}

# Endereço antigo por IP (http://187.77.254.161/gamedle/...) → domínio, sem o prefixo /gamedle.
http://187.77.254.161 {
	header X-Robots-Tag "noindex, nofollow"
	@gamedle path /gamedle /gamedle/*
	handle @gamedle {
		# route mantém a ordem escrita (sem ele o Caddy roda redir antes de uri e o /gamedle ficaria na URL)
		route {
			uri strip_prefix /gamedle
			redir https://gamedle.com.br{uri} permanent
		}
	}
	handle {
		respond "Not found" 404
	}
}
